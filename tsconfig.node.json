{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/utils/**/*",
    "src/config/**/*",
    "src/ipc/**/*",
    "src/global.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": [
      "electron-vite/node"
    ],
    "paths": {
      "@src/*": [
        "./src/*"
      ]
    }
  }
}
